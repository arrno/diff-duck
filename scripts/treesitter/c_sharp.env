# Pinned tree-sitter grammar for C#. Read by scripts/build-treesitter-wasm.sh (not sourced).
# The module is fetched through the Go module proxy, so sum.golang.org verifies its contents.
# v0.23.5 generates ABI 15, which the pinned tree-sitter core (v0.25) loads.
GRAMMAR_MODULE=github.com/tree-sitter/tree-sitter-c-sharp
GRAMMAR_VERSION=v0.23.5
# Directory inside the module that holds parser.c (and scanner.c when the grammar has one).
GRAMMAR_SRC=src
# The grammar's entry point, passed to the shim as -DTS_LANGUAGE.
GRAMMAR_SYMBOL=tree_sitter_c_sharp
