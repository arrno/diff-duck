# Pinned tree-sitter grammar for TSX (.tsx), the JSX dialect of tree-sitter-typescript (see
# typescript.env). Read by scripts/build-treesitter-wasm.sh (not sourced).
# The module is fetched through the Go module proxy, so sum.golang.org verifies its contents.
GRAMMAR_MODULE=github.com/tree-sitter/tree-sitter-typescript
GRAMMAR_VERSION=v0.23.2
GRAMMAR_SRC=tsx/src
# Module directories the sources include by relative path.
GRAMMAR_SHARED=common
GRAMMAR_SYMBOL=tree_sitter_tsx
